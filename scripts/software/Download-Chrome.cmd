@echo off
setlocal DisableDelayedExpansion
if not "%~2"=="" goto bad_arguments
if /i "%~1"=="--help" goto help
if not "%~1"=="" if /i not "%~1"=="--no-pause" goto bad_arguments
set "LAB_DOWNLOAD_"
set "LAB_DOWNLOAD_DIR=%CD%"
set "LAB_DOWNLOAD_NOPAUSE="
if /i "%~1"=="--no-pause" set "LAB_DOWNLOAD_NOPAUSE=1"
"%SystemRoot%\System32\WindowsPowerShell\v1.0\powershell.exe" -NoLogo -NoProfile -Command "function Get-DownloadPart { param([string]$Url,[string]$Path) $u=[uri]$Url; $r=$null; $s=$null; $o=$null; $until=[DateTime]::UtcNow.AddMinutes(30); try { for($hop=0;$hop -lt 10;$hop++) { if(-not $u.IsAbsoluteUri -or $u.Scheme -ne 'https' -or $u.UserInfo){throw 'Only credential-free HTTPS downloads are allowed'}; if([DateTime]::UtcNow -ge $until){throw 'Download time limit reached'}; $q=[Net.HttpWebRequest]::Create($u); $q.AllowAutoRedirect=$false; $q.Timeout=60000; $q.ReadWriteTimeout=60000; $q.UserAgent='lab-snippets/1'; $r=$q.GetResponse(); $status=[int]$r.StatusCode; if(@(301,302,303,307,308) -contains $status){$next=$r.Headers['Location']; if(-not $next){throw 'Redirect has no destination'}; $u=[uri]::new($u,$next); $r.Close(); $r=$null; continue}; if($status -ne 200){throw 'Download did not return HTTP 200'}; break; }; if($null -eq $r){throw 'Too many HTTPS redirects'}; $s=$r.GetResponseStream(); $o=[IO.File]::Open($Path,[IO.FileMode]::Open,[IO.FileAccess]::Write,[IO.FileShare]::None); if($o.Length -ne 0){throw 'Reserved partial file is not empty'}; $buffer=New-Object byte[] 65536; $received=0L; while(($n=$s.Read($buffer,0,$buffer.Length)) -gt 0){if([DateTime]::UtcNow -ge $until){throw 'Download time limit reached'}; $o.Write($buffer,0,$n); $received+=$n}; if($received -eq 0 -or ($r.ContentLength -ge 0 -and $received -ne $r.ContentLength)){throw 'Incomplete or empty download'}; $o.Flush($true); } finally { if($null -ne $o){$o.Dispose()}; if($null -ne $s){$s.Dispose()}; if($null -ne $r){$r.Close()}; }; }; function Test-DownloadPart { param($File,[string]$Path) $algorithm=[Security.Cryptography.SHA256]::Create(); $stream=[IO.File]::OpenRead($Path); try{$hash=[BitConverter]::ToString($algorithm.ComputeHash($stream)).Replace('-','').ToLowerInvariant()}finally{$stream.Dispose();$algorithm.Dispose()}; $checked=$false; if($File.sha256){if($hash -cne $File.sha256.ToLowerInvariant()){throw 'SHA256 does not match the pinned value'}; $checked=$true}; if($File.integrity){ if($File.integrity -cnotmatch '^sha512-([A-Za-z0-9+/]+={0,2})$'){throw 'Unsupported integrity value'}; $expected=$Matches[1]; $algorithm=[Security.Cryptography.SHA512]::Create(); $stream=[IO.File]::OpenRead($Path); try{$actual=[Convert]::ToBase64String($algorithm.ComputeHash($stream))}finally{$stream.Dispose();$algorithm.Dispose()}; if($actual -cne $expected){throw 'SHA512 does not match the pinned integrity'}; $checked=$true; }; if($File.signer_pattern){$signature=Get-AuthenticodeSignature -LiteralPath $Path; if($signature.Status -ne 'Valid' -or $null -eq $signature.SignerCertificate -or $signature.SignerCertificate.Subject -notmatch $File.signer_pattern){throw 'Valid expected publisher signature required'}; $checked=$true}; if(-not $checked -and $File.verification -ne 'https-only'){throw 'No recognized verification policy'}; return $hash; }; function Invoke-Download { $parts=@(); try { $ErrorActionPreference='Stop'; $ProgressPreference='SilentlyContinue'; foreach($module in @('Microsoft.PowerShell.Utility','Microsoft.PowerShell.Security')){Import-Module ([IO.Path]::Combine($PSHOME,('Modules\'+$module+'\'+$module+'.psd1'))) -ErrorAction Stop}; [Net.ServicePointManager]::SecurityProtocol=[Net.SecurityProtocolType]::Tls12; $package=[Text.Encoding]::UTF8.GetString([Convert]::FromBase64String($env:LAB_DOWNLOAD_META))|ConvertFrom-Json; $folder=[IO.Path]::GetFullPath($env:LAB_DOWNLOAD_DIR); if(-not [IO.Directory]::Exists($folder)){throw 'Current folder must be an existing filesystem directory'}; if(@($package.files).Count -lt 1){throw 'No files declared'}; foreach($file in $package.files){ if($file.filename -cnotmatch '^[A-Za-z0-9][A-Za-z0-9._+-]*$'){throw 'Unsafe output filename'}; $initial=[uri]$file.url; if(-not $initial.IsAbsoluteUri -or $initial.Scheme -ne 'https' -or $initial.UserInfo){throw 'Only credential-free HTTPS downloads are allowed'}; $target=[IO.Path]::Combine($folder,$file.filename); if([IO.File]::Exists($target) -or [IO.Directory]::Exists($target)){throw ('Already exists; will not overwrite: '+$file.filename)}; }; Write-Host ('Download only: '+$package.name+' '+$package.version); Write-Host ('Destination: '+$folder); foreach($file in $package.files){ $temporary=[IO.Path]::Combine($folder,('.download-'+[guid]::NewGuid().ToString('N')+'-'+$file.filename)); Write-Host ('Downloading '+$file.filename); $reservation=[IO.File]::Open($temporary,[IO.FileMode]::CreateNew,[IO.FileAccess]::Write,[IO.FileShare]::None); $reservation.Dispose(); $part=[pscustomobject]@{temporary=$temporary;target=[IO.Path]::Combine($folder,$file.filename);file=$file;hash=$null}; $parts+=@($part); Get-DownloadPart -Url $file.url -Path $temporary; $part.hash=Test-DownloadPart -File $file -Path $temporary; }; foreach($part in $parts){ [IO.File]::Move($part.temporary,$part.target); Write-Host ('Saved: '+$part.target); Write-Host ('SHA256: '+$part.hash); if($part.file.verification -eq 'https-only'){Write-Host 'HTTPS-only source: this local checksum is not independently pinned verification.'}; }; Write-Host 'Done. Nothing was installed or executed.'; return 0; } catch { Write-Host ('DOWNLOAD FAILED: '+$_.Exception.Message); Write-Host 'Nothing was installed or executed. Any earlier Saved files remain.'; return 2; } finally { foreach($part in $parts){try{[IO.File]::Delete($part.temporary)}catch{Write-Warning ('Could not remove partial file: '+$part.temporary)}}; }; }; $code=Invoke-Download; if($env:LAB_DOWNLOAD_NOPAUSE -ne '1' -and -not [Console]::IsInputRedirected -and -not [Console]::IsOutputRedirected){Write-Host 'Press Enter to close.';[void][Console]::ReadLine()}; exit $code"
exit /b %ERRORLEVEL%
:bad_arguments
echo Use --help or --no-pause only. 1>&2
exit /b 2
:help
echo Download-Chrome.cmd - download only
echo Saves to the current working folder, not the script folder.
echo No installation, extraction, execution, elevation or system changes.
echo Existing output files are refused, never overwritten.
echo Usage: "%~nx0" [--help ^| --no-pause]
echo File: googlechromestandaloneenterprise64.msi
exit /b 0
