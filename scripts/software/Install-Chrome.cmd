@echo off
setlocal DisableDelayedExpansion
set "LAB_INSTALL_SELF=%~f0"
if /i "%~1"=="--diagnose" goto diagnose
if not "%~1"=="" goto usage
echo WARNING: Downloads and installs Google Chrome for all users. Administrator/UAC consent is required. No automatic reboot.
echo [1] CMD started. Launching Windows PowerShell...
"%SystemRoot%\System32\WindowsPowerShell\v1.0\powershell.exe" -NoLogo -NoProfile -Command "Write-Host '[2] PowerShell started.'; function Get-DownloadPart { param([string]$Url,[string]$Path) $u=[uri]$Url; $r=$null; $s=$null; $o=$null; $until=[DateTime]::UtcNow.AddMinutes(30); try { for($hop=0;$hop -lt 10;$hop++) { if(-not $u.IsAbsoluteUri -or $u.Scheme -ne 'https' -or $u.UserInfo){throw 'Only credential-free HTTPS downloads are allowed'}; if([DateTime]::UtcNow -ge $until){throw 'Download time limit reached'}; $q=[Net.HttpWebRequest]::Create($u); $q.AllowAutoRedirect=$false; $q.Timeout=60000; $q.ReadWriteTimeout=60000; $q.UserAgent='lab-snippets/1'; $r=$q.GetResponse(); $status=[int]$r.StatusCode; if(@(301,302,303,307,308) -contains $status){$next=$r.Headers['Location']; if(-not $next){throw 'Redirect has no destination'}; $u=[uri]::new($u,$next); $r.Close(); $r=$null; continue}; if($status -ne 200){throw 'Download did not return HTTP 200'}; break; }; if($null -eq $r){throw 'Too many HTTPS redirects'}; $s=$r.GetResponseStream(); $o=[IO.File]::Open($Path,[IO.FileMode]::Open,[IO.FileAccess]::Write,[IO.FileShare]::None); if($o.Length -ne 0){throw 'Reserved partial file is not empty'}; $buffer=New-Object byte[] 65536; $received=0L; while(($n=$s.Read($buffer,0,$buffer.Length)) -gt 0){if([DateTime]::UtcNow -ge $until){throw 'Download time limit reached'}; $o.Write($buffer,0,$n); $received+=$n}; if($received -eq 0 -or ($r.ContentLength -ge 0 -and $received -ne $r.ContentLength)){throw 'Incomplete or empty download'}; $o.Flush($true); } finally { if($null -ne $o){$o.Dispose()}; if($null -ne $s){$s.Dispose()}; if($null -ne $r){$r.Close()}; }; }; $ErrorActionPreference='Stop'; $ProgressPreference='SilentlyContinue'; $code=2; $path=$null; $guard=$null; $stage='startup'; try { $stage='administrator check'; $principal=New-Object Security.Principal.WindowsPrincipal([Security.Principal.WindowsIdentity]::GetCurrent()); if (-not $principal.IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)) { throw 'Run this CMD as administrator from a local folder.'; }; if (-not [Environment]::Is64BitOperatingSystem) { throw 'Windows x64 is required.'; }; [Net.ServicePointManager]::SecurityProtocol=[Net.SecurityProtocolType]::Tls12; $stage='local staging'; $directory=Join-Path ([Environment]::GetFolderPath('CommonApplicationData')) ('lab-snippets-install-'+[guid]::NewGuid().ToString('N')); $acl=New-Object Security.AccessControl.DirectorySecurity; $acl.SetAccessRuleProtection($true,$false); foreach($sid in @('S-1-5-18','S-1-5-32-544')) { $identity=New-Object Security.Principal.SecurityIdentifier($sid); $rule=New-Object Security.AccessControl.FileSystemAccessRule($identity,'FullControl','ContainerInherit,ObjectInherit','None','Allow'); [void]$acl.AddAccessRule($rule); }; $folder=New-Object IO.DirectoryInfo($directory); $folder.Create($acl); $path=Join-Path $directory 'installer.msi'; $stage='download'; $file=[IO.File]::Open($path,[IO.FileMode]::CreateNew,[IO.FileAccess]::Write,[IO.FileShare]::None); $file.Dispose(); Write-Host 'Downloading the full official Chrome installer...'; Get-DownloadPart -Url 'https://dl.google.com/dl/chrome/install/googlechromestandaloneenterprise64.msi' -Path $path; $stage='verification'; $guard=[IO.File]::Open($path,[IO.FileMode]::Open,[IO.FileAccess]::Read,[IO.FileShare]::Read); $signature=Get-AuthenticodeSignature -LiteralPath $path; if ($signature.Status -ne 'Valid' -or $null -eq $signature.SignerCertificate -or $signature.SignerCertificate.Subject -notmatch '(?:^|,\s*)(?:CN|O)=Google (?:LLC|Inc\.?)\s*(?:,|$)') { throw 'Valid Google publisher signature required. Nothing installed.'; }; Write-Host 'Google signature verified. Installing from the local staging folder...'; $guard.Dispose(); $guard=$null; $stage='Windows Installer'; $arguments='/i '+[char]34+$path+[char]34+' /qn /norestart REBOOT=ReallySuppress'; $installer=Join-Path $env:SystemRoot 'System32\msiexec.exe'; $process=Start-Process -FilePath $installer -ArgumentList $arguments -WindowStyle Hidden -Wait -PassThru; $code=$process.ExitCode; if ($code -eq 0) { Write-Host 'Chrome installation completed.'; } elseif ($code -eq 3010) { Write-Host 'Chrome installed. Restart required; restart manually when ready.'; } else { Write-Host ('Windows Installer returned '+$code+'. Installation did not report success.'); }; } catch { Write-Host ('FAILED at '+$stage+': '+$_.Exception.Message+' [HRESULT '+$_.Exception.HResult+']'); $code=2; } finally { if ($null -ne $guard) { $guard.Dispose(); }; if ($path -and [IO.File]::Exists($path)) { try { [IO.File]::Delete($path); } catch { Write-Host ('Temporary installer retained: '+$path); }; }; }; exit $code;"
set "ExitCode=%ERRORLEVEL%"
echo Exit code: %ExitCode%
pause
exit /b %ExitCode%
:diagnose
echo [D1] CMD started. Launching read-only PowerShell diagnostic...
"%SystemRoot%\System32\WindowsPowerShell\v1.0\powershell.exe" -NoLogo -NoProfile -Command "Write-Host '[D2] PowerShell started. Read-only diagnostic: no downloads, elevation, writes or installation.'; $ErrorActionPreference='Stop'; try { $who=New-Object Security.Principal.WindowsPrincipal([Security.Principal.WindowsIdentity]::GetCurrent()); Write-Host ('Administrator token: '+$who.IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)); Write-Host ('PowerShell: '+$PSVersionTable.PSVersion); Write-Host ('Language mode: '+$ExecutionContext.SessionState.LanguageMode); Write-Host ('CommonApplicationData: '+[Environment]::GetFolderPath('CommonApplicationData')); Write-Host ('MSI executable present: '+[IO.File]::Exists((Join-Path $env:SystemRoot 'System32\msiexec.exe'))); $lines=[IO.File]::ReadAllLines($env:LAB_INSTALL_SELF); $line=@($lines | Where-Object { $_.Contains('function Get-DownloadPart') })[0]; $marker=' -Command '+[char]34; $source=$line.Substring($line.IndexOf($marker)+$marker.Length).TrimEnd([char]34); $tokens=$null; $errors=$null; [void][System.Management.Automation.Language.Parser]::ParseInput($source,[ref]$tokens,[ref]$errors); if($errors.Count){throw ($errors | Out-String)}; Write-Host '[D3] Embedded installer parses. Installation was NOT run.'; exit 0; } catch { Write-Host ('DIAGNOSTIC FAILED: '+$_.Exception.Message); exit 2; }"
set "ExitCode=%ERRORLEVEL%"
echo Diagnostic exit code: %ExitCode%
pause
exit /b %ExitCode%
:usage
echo Copy this CMD to a local drive and run as administrator.
echo Downloads the full Google Chrome x64 MSI, verifies Google signature, then installs.
echo Administrator rights required. No forced restart. Exit 3010 means restart required.
exit /b 2
